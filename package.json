{
  "name": "@project-template/root",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "oxfmt --check && oxlint --type-check && cspell --no-progress . && pnpm run knip && pnpm test",
    "fix": "oxlint --fix && oxfmt",
    "knip": "knip",
    "prepare": "husky",
    "test": "vitest run",
    "typecheck": "tsc && pnpm --recursive --if-present run typecheck"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@types/node": "^26.6.10",
    "cspell": "^10.5.2",
    "husky": "^9.1.7",
    "knip": "^6.48.0",
    "lint-staged": "^17.6.2",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "oxlint-tsgolint": "^7.0.2008",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
